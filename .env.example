# İsteğe bağlı yerel ayarlar. Gerçek şifreleri bu örnek dosyaya yazma.
ISG_APP_NAME="İSG Kamera Sistemi"
ISG_ENVIRONMENT=development

# Gerçek şifreyi yalnız Git'e girmeyen .env dosyasında değiştir.
ISG_DATABASE_HOST=127.0.0.1
ISG_DATABASE_PORT=5432
ISG_DATABASE_NAME=isg_kamera
ISG_DATABASE_USER=isg_app
ISG_DATABASE_PASSWORD=CHANGE_ME
ISG_DATABASE_POOL_SIZE=5
ISG_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Yerel HTTP geliştirmede false; HTTPS yerel ağ kurulumunda true yapılmalıdır.
ISG_SESSION_COOKIE_SECURE=false
ISG_SESSION_ABSOLUTE_HOURS=8
ISG_SESSION_IDLE_MINUTES=30
ISG_LOGIN_MAX_FAILURES=5
ISG_LOGIN_LOCK_MINUTES=15
